# ARDOR News — backend environment variables
# Copy this file to ".env" and fill in the real values. NEVER commit the real .env.
# All values below are intentionally blank.

# --- Claude / Anthropic (newsletter summarization) ---
ANTHROPIC_API_KEY=

# --- Supabase ---
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# SERVICE ROLE secret. Backend-only — full admin access, BYPASSES Row Level
# Security. Used for Storage uploads and for writing to the `subscribers`
# table from the RevenueCat webhook handler. Never ship this to the app.
SUPABASE_KEY=

# ANON (public) key. Safe to embed in the Flutter app — it is gated by Row
# Level Security. The app will use this for magic-link login and to read the
# user's own `subscribers` row. Added in the subscription feature (Phase A).
SUPABASE_ANON_KEY=

# --- Gmail (newsletter ingestion via IMAP) ---
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# --- Google Cloud Text-to-Speech ---
# JSON service-account credentials (as a single-line JSON string).
GOOGLE_TTS_CREDENTIALS=

# --- RevenueCat (subscription webhook) ---
# Secret value configured in RevenueCat dashboard's webhook settings.
# We compare the incoming Authorization header against this to verify
# the request really came from RevenueCat.
REVENUECAT_WEBHOOK_SECRET=

# RevenueCat's secret API key (server-side only), used to call their
# REST API and fetch a subscriber's canonical entitlement status.
REVENUECAT_SECRET_API_KEY=
